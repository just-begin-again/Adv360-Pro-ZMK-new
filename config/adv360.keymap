#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <250>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        copy_and_clipboard: copy_and_clipboard {
            compatible = "zmk,behavior-tap-dance";
            label = "COPY_AND_CLIPBOARD";
            #binding-cells = <0>;
            bindings = <&mt LG(LS(C)) C>, <&kp LG(C)>;
        };

        paste_w_D: paste_w_D {
            compatible = "zmk,behavior-tap-dance";
            label = "PASTE_W_D";
            #binding-cells = <0>;
            bindings = <&kp D>, <&kp LG(V)>;
        };

        paste_w_V: paste_w_V {
            compatible = "zmk,behavior-tap-dance";
            label = "PASTE_W_V";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp LG(V)>;
        };

        screenshots_and_ocr: screenshots_and_ocr {
            compatible = "zmk,behavior-tap-dance";
            label = "SCREENSHOTS_AND_OCR";
            #binding-cells = <0>;
            bindings =
                <&mt LG(LS(NUMBER_3)) LG(LS(NUMBER_4))>,
                <&kp LG(LS(NUMBER_2))>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL              &kp N1     &kp N2       &kp N3               &lt 4 N4        &kp N5  &tog 2                                                                                  &mo 4                         &kp N6  &kp N7           &kp N8           &kp N9       &kp N0    &kp MINUS
&kp ESCAPE             &kp Q      &kp W        &kp E                &kp R           &kp T   &none                                                                                   &none                         &kp Y   &kp U            &kp I            &kp O        &kp P     &kp BSLH
&kp TAB                &kp A      &hm LCTRL S  &hm LEFT_ALT D       &hm LEFT_GUI F  &kp G   &trans    &mo 5                          &kp LALT                  &kp LGUI  &mo 5      &tog 2                        &kp H   &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RCTRL L  &kp SEMI  &kp SQT
&kp LSHFT              &kp Z      &kp X        &copy_and_clipboard  &paste_w_V      &kp B                                            &screenshots_and_ocr      &kp CAPS                                           &kp N   &kp M            &kp COMMA        &kp DOT      &kp FSLH  &kp RSHFT
&switch_to_colemak_dh  &kp GRAVE  &trans       &kp LEFT             &kp RIGHT               &kp BSPC  &mt LC(LA(LEFT_SHIFT)) DELETE  &mo 7                     &mo 6     &kp ENTER  &mt LC(LA(LEFT_SHIFT)) SPACE          &kp UP           &kp DOWN         &kp LBKT     &kp RBKT  &tog 8
            >;
        };

        layer_colemak_dh {
            bindings = <
&trans             &trans  &trans       &trans               &trans          &trans  &tog 2                                                                                       &trans                        &trans  &trans           &trans           &trans       &trans         &trans
&kp ESCAPE         &kp Q   &kp W        &kp F                &kp P           &kp B   &none                                                                                        &none                         &kp J   &kp L            &kp U            &kp Y        &kp SEMICOLON  &trans
&kp TAB            &kp A   &hm LCTRL R  &hm LEFT_ALT S       &hm LEFT_GUI T  &kp G   &trans         &mo 5                          &kp LEFT_ALT              &kp RCMD  &mo 5      &tog 2                        &kp M   &hm RIGHT_GUI N  &hm RIGHT_ALT E  &hm RCTRL I  &kp O          &trans
&kp LEFT_SHIFT     &kp Z   &kp X        &copy_and_clipboard  &paste_w_D      &kp V                                                 &screenshots_and_ocr      &kp CAPS                                           &kp K   &kp H            &kp COMMA        &kp PERIOD   &kp SLASH      &kp RIGHT_SHIFT
&switch_to_qwerty  &trans  &trans       &kp LEFT             &kp RIGHT               &kp BACKSPACE  &mt LC(LA(LEFT_SHIFT)) DELETE  &mo 7                     &mo 6     &kp ENTER  &mt LC(LA(LEFT_SHIFT)) SPACE          &kp UP           &kp DOWN         &kp F20      &kp F21        &tog 8
            >;
        };

        layer_keypad {
            bindings = <
&kp EQUAL  &kp N1          &kp N2             &kp N3           &kp N4     &kp N5  &trans                                                   &trans     &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp C_PREVIOUS  &kp C_PP           &kp C_NEXT       &none      &none   &none                                                    &none      &none   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp K_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none      &none   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans     &none   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &trans          &kp C_BRI_DEC      &kp C_BRI_UP     &none      &none                        &kp HOME      &kp PG_UP                        &none   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&trans     &kp GRAVE       &none              &kp LEFT         &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &trans
            >;
        };

        layer_fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 2                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0                                                            &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                                      &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &tog 0  &bt BT_CLR      &bt BT_CLR      &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none                              &none           &none                                               &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none   &none           &bl BL_SET 100  &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        layer_symbols {
            bindings = <
&trans   &trans                &trans            &trans             &trans                 &trans  &tog 2                                      &trans      &trans     &trans                          &trans                &trans              &trans               &trans
&trans   &kp ESCAPE            &trans            &trans             &trans                 &trans  &to 0                                       &trans      &trans     &mt ASTRK SLASH                 &kp PLUS              &mt PIPE AMPERSAND  &kp HASH             &trans
&kp ESC  &kp LEFT_BRACE        &kp LT            &kp GREATER_THAN   &kp RIGHT_BRACE        &trans  &to 1   &trans  &trans      &trans  &trans  &trans      &kp GRAVE  &mt SINGLE_QUOTE DOUBLE_QUOTES  &mt COMMA DOT         &kp EQUAL           &mt SEMICOLON COLON  &trans
&trans   &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &trans                  &trans      &trans                      &trans     &mt QUESTION EXCL               &mt UNDERSCORE MINUS  &kp AT              &trans               &trans
&trans   &trans                &trans            &trans             &trans                         &trans  &trans  &trans      &trans  &trans  &kp ESCAPE             &trans                          &trans                &trans              &trans               &trans
            >;
        };

        layer_left_arrows {
            bindings = <
&trans                     &trans                 &trans    &trans    &trans     &trans  &trans                                              &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans                     &trans                 &trans    &kp UP    &trans     &trans  &trans                                              &trans  &trans  &trans  &trans  &trans  &trans  &trans
&mt LS(LEFT_GUI) LEFT_GUI  &mt LS(LALT) LEFT_ALT  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans    &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans                     &trans                 &trans    &trans    &trans     &trans                          &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans                     &trans                 &trans    &trans    &trans             &kp LGUI  &kp LEFT_ALT  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_right_arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                             &trans         &trans  &trans          &trans          &trans           &trans                       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                             &trans         &trans  &trans          &kp UP_ARROW    &trans           &trans                       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans         &trans         &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &mt RS(RIGHT_ALT) RIGHT_ALT  &mt RS(RIGHT_GUI) RIGHT_GUI
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                                &trans  &trans          &trans          &trans           &trans                       &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &kp RIGHT_ALT  &kp RIGHT_GUI          &trans          &trans          &trans           &trans                       &trans
            >;
        };

        layer_nav {
            bindings = <
&trans  &trans             &trans                    &trans                     &trans                 &trans  &trans                                                                    &trans     &trans  &trans          &trans          &trans           &trans           &trans
&trans  &kp LG(LBKT)       &kp LG(LS(LEFT_BRACKET))  &kp LG(LS(RIGHT_BRACKET))  &kp LG(RIGHT_BRACKET)  &trans  &to 0                                                                     &trans     &trans  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans           &trans
&trans  &mt LG(LEFT) LEFT  &hm LEFT_ALT DOWN         &hm LEFT_GUI UP            &mt LG(RIGHT) RIGHT    &trans  &to 1          &kp LEFT_GUI  &kp LEFT_ALT              &trans  &trans     &trans     &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mt LG(TAB) TAB  &trans
&trans  &trans             &trans                    &trans                     &trans                 &trans                               &screenshots_and_ocr      &trans                        &trans  &msc SCRL_UP    &trans          &msc SCRL_DOWN   &trans           &trans
&trans  &trans             &trans                    &kp LEFT                   &kp RIGHT                      &kp BACKSPACE  &kp DELETE    &trans                    &trans  &mkp RCLK  &mkp LCLK          &kp UP          &kp DOWN        &trans           &trans           &trans
            >;
        };
    };
};
